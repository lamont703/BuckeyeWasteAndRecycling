# Copy to .env.local and fill in. Everything is optional: with nothing set, the site
# still works and form submissions are only printed to the server log.

# --- Lead delivery (set at least one before launch) ---
# Email via Resend (https://resend.com). Verify buckeyewr.com as a sending domain first.
RESEND_API_KEY=
LEAD_TO_EMAIL=hello@buckeyewr.com
LEAD_FROM_EMAIL="Buckeye Website <leads@buckeyewr.com>"
# Optional JSON webhook, e.g. a GoHighLevel / Zapier / Make inbound webhook URL
LEAD_WEBHOOK_URL=

# --- Stripe subscriptions (residential plans) ---
# Without these, "Start free trial" submits a lead instead of opening Stripe Checkout.
STRIPE_SECRET_KEY=
STRIPE_PRICE_NEIGHBOR=
STRIPE_PRICE_BUCKEYE=
STRIPE_PRICE_ESTATE=
