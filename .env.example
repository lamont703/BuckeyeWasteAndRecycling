# Copy to .env.local and fill in. Everything is optional: with nothing set, the site
# still works and form submissions are only printed to the server log.

# --- Supabase (lead database) ---
# Every lead is saved to the `leads` table (schema in supabase/migrations).
# The secret key is server-only: never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- GoHighLevel CRM (recommended) ---
# Sub-account → Settings → Private Integrations → create a token with scopes:
#   contacts.write, contacts.readonly, opportunities.write
# Location ID: Sub-account → Settings → Business Profile (or the ID in the GHL URL).
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=
# Optional: open an opportunity for every sales lead. IDs come from
# Opportunities → Pipelines (or GET /opportunities/pipelines).
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=
# Optional override; GHL docs currently show both "2021-07-28" and "v3".
GHL_API_VERSION=

# --- Other lead delivery channels (optional, can run alongside GHL) ---
# Email via Resend (https://resend.com). Verify buckeyewr.com as a sending domain first.
RESEND_API_KEY=
LEAD_TO_EMAIL=hello@buckeyewr.com
LEAD_FROM_EMAIL="Buckeye Website <leads@buckeyewr.com>"
# Optional JSON webhook, e.g. a GoHighLevel / Zapier / Make inbound webhook URL
LEAD_WEBHOOK_URL=

# --- Stripe subscriptions (residential plans) ---
# Without these, "Start free trial" submits a lead instead of opening Stripe Checkout.
STRIPE_SECRET_KEY=
STRIPE_PRICE_NEIGHBOR=
STRIPE_PRICE_BUCKEYE=
STRIPE_PRICE_ESTATE=
